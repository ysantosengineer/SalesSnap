# Application
APP_NAME=SalesSnap
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://sales_snap:sales_snap@localhost:5432/sales_snap

# Authentication
JWT_SECRET_KEY=change-me-use-a-long-random-local-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Import
MAX_UPLOAD_SIZE_MB=10

# Rate limiting (per minute, per IP or authenticated user)
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_IMPORT_PER_MINUTE=10
RATE_LIMIT_AI_INSIGHTS_PER_MINUTE=5
RATE_LIMIT_AI_CHAT_PER_MINUTE=10
RATE_LIMIT_FORECAST_PER_MINUTE=30

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_INSIGHTS_ENABLED=false
AI_INSIGHTS_TIMEOUT_SECONDS=30
AI_INSIGHTS_MAX_ITEMS_PER_SECTION=5

# AI Chat
AI_CHAT_HISTORY_MESSAGES=10
AI_CHAT_MAX_TOOL_CALLS=5
AI_CHAT_MAX_OUTPUT_TOKENS=800
